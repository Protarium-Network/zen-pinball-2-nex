# Zen Pinball 2 (Wii U) - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_ZP2_*.

# --- PRUDP listeners ---
PN_ZP2_AUTH_PORT=28500
PN_ZP2_SECURE_PORT=28501
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_ZP2_SECURE_HOST=localhost

# --- Database (ranking) ---
PN_ZP2_POSTGRES_URI=postgres://zp2:zp2@localhost:5432/zp2?sslmode=disable

# --- Kerberos / system accounts ---
PN_ZP2_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_ZP2_LOCAL_MODE=1
PN_ZP2_SETTINGS_PATH=settings.json

# Required only when PN_ZP2_LOCAL_MODE is not 1:
PN_ZP2_NEX_TOKEN_AES_KEY=
PN_ZP2_NEX_PASSWORD_SECRET=

# --- Wire settings (defaults are 3.4.13 / legacy signature, see README) ---
# PN_ZP2_NEX_VERSION=3.4.13
# PN_ZP2_LEGACY_SIGNATURE=1
# PN_ZP2_STRUCTURE_HEADER=0
